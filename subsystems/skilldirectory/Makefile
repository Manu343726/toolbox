SHELL := /bin/sh
export PATH := $(HOME)/go/bin:$(PATH)

# A contributor has no contract of its own, so it has no `proto` target and no generated
# package: rule 14 gives a provider with no operations to address no proto, no command and no
# binary, and a subsystem that only configures is the same case one level up. The catalog
# contract it composes a provider for is generated by that provider's own module.
NAME := skilldirectory
MODULE := github.com/Manu343726/toolbox/subsystems/skilldirectory
BIN := bin/$(NAME)

.PHONY: all build test test-short fmt vet clean

all: build

build:
	@mkdir -p $(dir $(BIN))
	go build -o $(BIN) ./cmd/$(NAME)

test:
	go test -count=1 ./...

test-short:
	go test -count=1 -short ./...

fmt:
	gofmt -l -w $(shell find . -name '*.go' -not -path './bin/*')

vet:
	go vet ./...

clean:
	rm -rf bin
