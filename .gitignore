**/bin/
**/*.pb.go
**/*.connect.go
# A .proto is source and is tracked; a descriptor set is a build artefact and is
# not generated any more, because documentation is read from the .proto itself.
# See pkg/docs/protosource.go and docs/decisions/0011-deployment-configuration.md.
**/*_docs.go
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# a stray build in a module directory is never source
cmd/toolbox/toolbox

# a deployment's default log, wherever a command was run without a configuration file
toolbox.log
logger.log
*.log
