**/bin/
**/*.pb.go
**/*.connect.go
subsystems/*/proto/*.pb
# framework contracts live under a canonical package path, so the pattern must
# match the nested descriptor set as well
pkg/**/proto/**/*.pb
**/*_docs.go
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# a stray build in a module directory is never source
cmd/toolbox/toolbox

# a deployment's default log, wherever a command was run without a configuration file
toolbox.log
logger.log
*.log
